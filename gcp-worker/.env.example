# olmOCR Worker Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# GCP Configuration (required)
# ============================================
GCP_PROJECT_ID=juniper-core
GCS_BUCKET=olmocr-juniper-core
PUBSUB_SUBSCRIPTION=olmocr-jobs-sub

# ============================================
# Processing Mode (choose one)
# ============================================
# Options: "parasail" (API, recommended) or "local_gpu" (self-hosted)
PROCESSING_MODE=parasail

# ============================================
# Parasail API Configuration (for PROCESSING_MODE=parasail)
# ============================================
PARASAIL_API_KEY=your-parasail-api-key
PARASAIL_API_URL=https://api.parasail.io/v1/chat/completions
PARASAIL_MODEL=allenai/olmOCR-2-7B-1025

# ============================================
# Local GPU Configuration (for PROCESSING_MODE=local_gpu)
# ============================================
# MODEL_NAME=allenai/olmOCR-2-7B-1025-FP8
# VLLM_PORT=30024
# VLLM_URL=  # Optional: external vLLM server URL

# ============================================
# Processing Settings
# ============================================
TARGET_LONGEST_IMAGE_DIM=1288
MAX_PAGE_RETRIES=8
MAX_CONCURRENT_PAGES=10

# ============================================
# Worker Settings
# ============================================
MAX_MESSAGES=1
ACK_DEADLINE=600

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
