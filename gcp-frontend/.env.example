# olmOCR Frontend Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
# For local development:
VITE_API_URL=http://localhost:8000/api
# For production (update with your Cloud Run backend URL):
# VITE_API_URL=https://olmocr-backend-xxxxx-uc.a.run.app/api

# Firebase Configuration
# Get these values from Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=juniper-core.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=juniper-core
VITE_FIREBASE_STORAGE_BUCKET=juniper-core.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef

# Optional: Analytics
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Feature Flags (optional)
VITE_ENABLE_GOOGLE_LOGIN=true
VITE_MAX_UPLOAD_SIZE_MB=100
