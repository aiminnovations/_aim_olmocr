# olmOCR Backend Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Server Configuration
# ============================================
HOST=0.0.0.0
PORT=8080
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# GCP Configuration
# ============================================
GCP_PROJECT_ID=juniper-core
GCS_BUCKET=olmocr-juniper-core
REGION=us-central1

# ============================================
# Firebase Authentication
# ============================================
# Path to Firebase Admin SDK JSON file
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-admin-sdk.json
# Or use base64 encoded credentials for Cloud Run:
# FIREBASE_CREDENTIALS_BASE64=base64-encoded-json

# ============================================
# Pub/Sub Configuration
# ============================================
PUBSUB_TOPIC=olmocr-jobs
PUBSUB_SUBSCRIPTION=olmocr-jobs-sub

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-domain.com

# ============================================
# Storage Configuration
# ============================================
MAX_UPLOAD_SIZE_MB=100
PRESIGNED_URL_EXPIRY_HOURS=1

# ============================================
# Rate Limiting (optional)
# ============================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
