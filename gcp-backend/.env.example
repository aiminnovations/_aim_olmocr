# olmOCR Backend Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCS_BUCKET=olmocr-your-project-id
REGION=us-central1

# Firebase Authentication
FIREBASE_CREDENTIALS_PATH=/path/to/firebase-admin-sdk.json
# Or use base64 encoded credentials:
# FIREBASE_CREDENTIALS_BASE64=base64-encoded-json

# Pub/Sub Configuration
PUBSUB_TOPIC=olmocr-jobs
PUBSUB_SUBSCRIPTION=olmocr-jobs-sub

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Storage Configuration
MAX_UPLOAD_SIZE_MB=100
PRESIGNED_URL_EXPIRY_HOURS=1

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Optional: Redis for caching (for production)
# REDIS_URL=redis://localhost:6379
